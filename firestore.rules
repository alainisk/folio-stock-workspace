rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /folioWorkspaces/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['revision', 'chunkCount', 'schemaVersion', 'updatedAt'])
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.chunkCount is int && request.resource.data.chunkCount > 0 && request.resource.data.chunkCount <= 50
        && request.resource.data.schemaVersion == 2
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/folioWorkspaces/$(uid)) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/folioWorkspaces/$(uid)) && request.resource.data.revision == resource.data.revision + 1));
      match /chunks/{chunk} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['value'])
          && request.resource.data.value is string && request.resource.data.value.size() <= 600000;
      }
    }
  }
}
